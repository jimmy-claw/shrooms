     "refId": "A",
     "expr": "1 - max by (node) (sum by (node, job) (rate(shrooms_host_cpu_seconds_total{mode=\"idle\"}[5m]))) / max by (node) (sum by (node, job) (rate(shrooms_host_cpu_seconds_total[5m])))",
