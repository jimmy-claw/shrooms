    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true
      },
      "renameByName": {
       "Value #A": "up",
       "Value #B": "relayed"
